				{
					"name": "03 - Patient Sign In",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Patient signin successful\", function () {",
									"    pm.response.to.have.status(200);",
									"    ",
									"    // Extract token from response and set as variable",
									"    const response = pm.response.json();",
									"    const token = response.message; // Assuming token is in message field",
									"    pm.environment.set(\"patient_token\", token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
